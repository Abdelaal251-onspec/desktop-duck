{
  "name": "desktop-duck",
  "version": "1.0.0",
  "description": "A 3D rubber duck for your desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.onspec.desktop-duck",
    "productName": "Desktop Duck",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "duck.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "duck.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Abdelaal251-onspec",
        "repo": "desktop-duck"
      }
    ]
  },
  "keywords": [
    "duck",
    "electron",
    "threejs"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "27.3.11",
    "electron-builder": "24.13.3"
  },
  "dependencies": {
    "three": "^0.184.0"
  }
}
